{
	"trailingComma": "none",
	"singleQuote": true,
	"printWidth": 100,
	"useTabs": true,
	"tabWidth": 4,
	"plugins": ["prettier-plugin-organize-imports", "prettier-plugin-svelte"],
	"organizeImportsSkipDestructiveCodeActions": true,
	"overrides": [
		{
			"files": "*.md",
			"options": {
				"embeddedLanguageFormatting": "off"
			}
		},
		{
			"files": "*.svelte",
			"options": {
				"parser": "svelte"
			}
		}
	]
}
