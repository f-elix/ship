{
	"name": "ship-monorepo",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.21.0",
	"engines": {
		"node": ">=26.13"
	},
	"scripts": {
		"build": "pnpm --filter @f-elix/ship build",
		"gen:schemas": "node packages/cli/scripts/gen-schemas.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "oxlint --max-warnings 0",
		"typecheck": "tsc -b && pnpm --filter @ship/ui check",
		"test": "vitest run",
		"check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run format:check"
	},
	"devDependencies": {
		"@effect/vitest": "4.1.4",
		"@types/node": "26.6.6",
		"oxlint": "1.81.0",
		"prettier": "3.9.6",
		"prettier-plugin-organize-imports": "4.3.0",
		"prettier-plugin-svelte": "4.1.1",
		"tsdown": "0.23.7",
		"typescript": "6.0.3",
		"vitest": "5.1.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.13.1",
			"onFail": "download"
		}
	}
}
